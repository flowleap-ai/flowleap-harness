{
  "name": "@deepseek-ai/dsh-flowleap-web",
  "description": "The FlowLeap Patent Agent profile layer over dsh-web-app: the patent preset as default, the FlowLeap brand, DeepSeek rows off, the in-process office connectors, the paid FlowLeap MCP tools, the flowleap-plugins skill pack, a file-backed patent persona, and Anthropic, OpenRouter and Mistral routes",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/bundle/flowleap-web"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "icon": "./icon.svg",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./presets/*.patch.yml": "./presets/*.patch.yml",
    "./prompt/*.md": "./prompt/*.md",
    "./brand/*": "./brand/*",
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "lib/index.js",
    "cordis.patch.yml",
    "presets/patent.patch.yml",
    "presets/standard.patch.yml",
    "presets/ptc.patch.yml",
    "prompt/patent-agent.md",
    "brand/brand.json",
    "brand/flowleap-mark.svg",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./presets/patent.patch.yml",
        "./presets/standard.patch.yml",
        "./presets/ptc.patch.yml"
      ],
      "lockedRows": [
        "llm-pi-ai",
        "credentials",
        "ui-settings-models",
        "plugin-manager",
        "llm-deepseek",
        "llm-deepseek-account",
        "deepseek-account",
        "deepseek-llm-api-extensions",
        "ui-settings-account",
        "account-controller",
        "web-search-deepseek",
        "web-deepseek-api",
        "session-telemetry-otel",
        "desktop-product-telemetry",
        "product-analytics",
        "flowleap-admin-link"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-agent-preset": "workspace:*",
    "@deepseek-ai/dsh-client-ui-brand-flowleap": "workspace:*",
    "@deepseek-ai/dsh-client-ui-flowleap-admin-link": "workspace:*",
    "@deepseek-ai/dsh-client-ui-flowleap-agent-builder": "workspace:*",
    "@deepseek-ai/dsh-client-ui-flowleap-budget": "workspace:*",
    "@deepseek-ai/dsh-client-ui-flowleap-dashboard": "workspace:*",
    "@deepseek-ai/dsh-client-ui-flowleap-routines": "workspace:*",
    "@deepseek-ai/dsh-client-ui-flowleap-work-pages": "workspace:*",
    "@deepseek-ai/dsh-client-ui-settings-flowleap-connectors": "workspace:*",
    "@deepseek-ai/dsh-flowleap-agent-builder": "workspace:*",
    "@deepseek-ai/dsh-flowleap-budget": "workspace:*",
    "@deepseek-ai/dsh-flowleap-connectors": "workspace:*",
    "@deepseek-ai/dsh-flowleap-deliverables": "workspace:*",
    "@deepseek-ai/dsh-flowleap-prompt": "workspace:*",
    "@deepseek-ai/dsh-flowleap-routines": "workspace:*",
    "@deepseek-ai/dsh-mcp-client": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  }
}
