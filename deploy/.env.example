# Copy to deploy/.env and fill in. docker compose reads this file.

# The image tag `docker build` produced (see README, "Install").
HARNESS_IMAGE=flowleap-harness:0.2.1-rc.2

# Your tailnet's DNS suffix, shown in the Tailscale admin console under DNS → Tailnet name.
TAILNET=tail1234.ts.net

# A reusable, pre-approved Tailscale auth key for the tag `tag:harness`
# (admin console → Settings → Keys → Generate auth key: Reusable, Pre-approved, Tags: tag:harness).
TS_AUTHKEY=tskey-auth-replace-me
