{
  "name": "@flowleap/connectors",
  "version": "0.1.0",
  "description": "FlowLeap patent-data connectors: the EPO OPS, USPTO ODP, academic (Semantic Scholar, arXiv) and Mistral OCR clients behind a host interface (ADR 0019)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/__fixtures__"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:run": "vitest run",
    "lint": "eslint src/"
  },
  "license": "MIT",
  "dependencies": {
    "@hyzyla/pdfium": "^3.0.0",
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0",
    "xml2js": "^0.6.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/pngjs": "^6.0.5",
    "@types/xml2js": "^0.4.14"
  }
}
