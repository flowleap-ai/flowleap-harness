{
  "name": "@flowleap/connectors",
  "description": "FlowLeap patent-data connectors, vendored from flowleap-backend packages/connectors: the EPO OPS, USPTO ODP, academic (Semantic Scholar, arXiv) and Mistral OCR clients behind the ConnectorHost interface (ADR 0019)",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "vendor/flowleap-connectors"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "src"
  ],
  "license": "MIT",
  "dependencies": {
    "xml2js": "^0.6.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/xml2js": "^0.4.14"
  }
}
